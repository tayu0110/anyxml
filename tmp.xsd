<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="root" type="ct" />
	<xs:complexType name="ct">
		<xs:attribute name="att1" type="xs:string" />
		<xs:attribute name="att2" type="xs:string" />
	</xs:complexType>

	<xs:complexType name="ct-ext">
		<xs:complexContent>
			<xs:extension base="ct">
				<!-- <xs:attribute name="att2" type="xs:string" use="prohibited" /> -->
				<xs:attribute name="att1" type="xs:string" />
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:simpleType name="ct">
		<xs:restriction base="xs:string">
			<xs:pattern value="\d+" />
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
